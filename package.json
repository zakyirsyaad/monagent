{
  "name": "monagent",
  "version": "0.1.0",
  "private": true,
  "description": "MetaMask Agent Wallet Plugin for Monad A2A Commerce & Trust (Metropolis Hackathon)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "demo:local": "tsx scripts/demo-monad-plugin.ts",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "@noble/hashes": "^2.2.0",
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "@supabase/supabase-js": "^2.110.0",
    "ethers": "^6.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
