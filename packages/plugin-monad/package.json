{
  "name": "@zakyirsyaad/monagent-plugin",
  "version": "0.2.1",
  "description": "MetaMask Agent Wallet Plugin for Monad A2A Commerce & Trust (ERC-8004 & x402)",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "metamask-agent-wallet-plugin",
    "monad",
    "erc-8004",
    "agentic-commerce"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "skills",
    "oclif.manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-skill.mjs && tsc -p tsconfig.json && oclif manifest",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@x402/core": "^2.18.0",
    "@x402/evm": "^2.18.0",
    "viem": "2.55.8",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@metamask/agent-wallet": "^6.2.0 || ^7.0.0"
  },
  "devDependencies": {
    "@metamask/agent-wallet": "^6.2.1",
    "@oclif/core": "^4.14.0",
    "@types/node": "^26.1.0",
    "oclif": "^4.24.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "oclif": {
    "commands": "./dist/commands",
    "bin": "mm",
    "topicSeparator": " "
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.2.0 || ^7.0.0",
    "capabilities": [],
    "commands": [
      {
        "id": "monad:pay",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "balances"
        ],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:identity:register",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:identity:get",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:reputation:check",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:reputation:give",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:x402:pay",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "balances"
        ],
        "targetChains": [
          10143,
          143
        ]
      },
      {
        "id": "monad:jobs:create",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "balances"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "monad:jobs:complete",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "balances"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "monad:jobs:refund",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "balances"
        ],
        "targetChains": [
          10143
        ]
      },
      {
        "id": "monad:skill",
        "capabilities": [],
        "dataAccess": [],
        "targetChains": "any"
      }
    ]
  },
  "license": "MIT"
}
